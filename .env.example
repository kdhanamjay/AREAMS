# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6InOf069NU4IsrDiuGstILJtev4edvnFUUimKs-8AWr5w"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Microsoft SQL Server Express (mssql) Configuration
# Set these variables to connect EAMS directly to your local or remote SQL Server Express instance
MSSQL_SERVER=localhost
MSSQL_DATABASE=EAMS_AssetDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourPassword123!
MSSQL_PORT=1433
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# MySQL 8.0.45 Configuration
# Set these variables if connecting directly to your local MySQL 8.0.45 server
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eams_db
MYSQL_USER=root
MYSQL_PASSWORD=YourMySQLPassword123!

